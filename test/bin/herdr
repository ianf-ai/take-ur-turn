#!/usr/bin/env node
// Herdr CLI fixture for tut-up tests: PATH injection stubs
// the real binary — no mock of process internals, runUp spawns this like any
// herdr. Every invocation is logged (argv space-joined, one line) to
// $TUT_HERDR_LOG; outputs mirror the REAL herdr JSON verified live:
//   pane list   → {"id":"cli:pane:list","result":{"panes":[...],"type":"pane_list"}}
//   pane split  → {"result":{"pane":{"pane_id":...},"type":"pane_info"}} (new pane)
//   tab create  → {"id":"cli:tab:create","result":{"root_pane":{pane_id,tab_id},
//                 "tab":{label,tab_id,pane_count},"type":"tab_created"}}
//                 (ships an EMPTY root pane)
//   pane move   → {"result":{"move_result":{changed,pane},"type":"pane_move"}}
//   pane close  → {"result":{"type":"ok"}}
//   pane rename → {"result":{"pane":{"pane_id","label"},"type":"pane_info"}}
//   pane run    → {"result":{"type":"ok"}}
//   pane send-text → {"result":{"type":"ok"}} (the delivery probe uses a
//                 literal printf command with a trailing escaped newline)
//   pane send-keys → {"result":{"type":"ok"}}
//   pane read   → RAW TEXT (no JSON envelope — mirrors real herdr): the value
//                 of TUT_HERDR_PANE_READ; when TUT_HERDR_READ_EMPTY_POLLS=N
//                 the first N reads return empty (simulates the born pane's
//                 boot window before the receiver UI paints). The screen
//                 TIMELINE knob TUT_HERDR_READ_SCRIPT takes precedence
//                 over both static knobs: a JSON array of screens where
//                 read #k serves screens[k-1] and the LAST screen repeats
//                 forever — scripts a whole birth/delivery sequence
//                 (boot → paint → text lands → submit reaction) for the
//                 closed-loop delivery tests. TUT_HERDR_READ_ENTER_SCRIPT
//                 (highest precedence, POST-text reads only) is indexed by
//                 ENTER COUNT: after a `pane send-text <pane>` for the pane
//                 being read, read serves screens[enters-on-this-pane], the
//                 last screen repeating — models “each Enter swallowed
//                 until the k-th commits” CAUSALLY, independent of poll
//                 cadence (loop-resend tests). A read immediately after a
//                 probe send can echo its marker when the probe script allows
//                 it. Pre-text reads (gate / continuation snapshot) fall back
//                 to the knobs above.
//   tab list    -> {"result":{"tabs":[...]}} from TUT_HERDR_TABS (JSON array
//                 of {label, tab_id} objects) — the tab-id recovery
//                 channel (tab create output unparseable, exit 0)
//   Optional readiness injection: TUT_HERDR_AGENT_STATUS or
//   TUT_HERDR_AGENT_STATUS_SCRIPT makes pane list expose a virtual FIX:root1
//   agent_status after pane run, mirroring Herdr's lifecycle readiness signal.
// Env:
//   TUT_HERDR_LOG   — log file path (one line per invocation)
//   TUT_HERDR_PANES — JSON array of pane objects returned by `pane list`
//   TUT_HERDR_FAIL  — comma list of "sub:verb" keys (e.g. "pane:move") whose
//                     calls fail: stderr line + exit 1 (failure-path tests;
//                     a plain key fails EVERY call); "sub:verb:N" fails only
//                     the Nth call of that verb (1-based — fallback tests)
//   TUT_HERDR_PANE_READ      — text `pane read` serves (default "")
//   TUT_HERDR_READ_EMPTY_POLLS — first N `pane read` calls serve "" (boot)
//   TUT_HERDR_READ_SCRIPT    — JSON array of screens; read #k serves
//                 screens[k-1], the last screen repeats forever (wins over
//                 the two static knobs above)
//   TUT_HERDR_READ_ENTER_SCRIPT — JSON array of screens; reads of a pane
//                 that already received a `pane send-text` serve
//                 screens[send-keys-Enter count on that pane], the last
//                 screen repeating (wins over everything for post-text
//                 reads; pre-text reads use the knobs above)
//   TUT_HERDR_PROBE_SCRIPT — optional JSON boolean array; the nth probe read
//                 includes its marker only when the nth value is true. When
//                 omitted, enter-script screens containing "prompt" model a
//                 swallowed Enter and otherwise echo a probe on non-empty
//                 screens.
//   TUT_HERDR_TABS           — tabs served by `tab list` (tab-id recovery)
//   TUT_HERDR_PANE_LABEL      — label served by `pane get` (default "<id>:label");
//                 TUT_HERDR_PANE_LABEL_RAW instead prints arbitrary raw text
//                 for `pane get` (invalid-JSON injection)
//   TUT_HERDR_TAB_CREATE_RAW — when set, `tab create` prints this RAW text
//                 (non-JSON) and exits 0 — the unparseable-success injection
//   TUT_HERDR_TAB_CREATE_SIGNAL — when set, `tab create` is terminated by
//                 this signal after logging, modelling a remote mutation whose
//                 response was lost
//   TUT_HERDR_PANES_RAW       — when set, `pane list` prints this RAW text
//                 instead of JSON — the unusable-inventory injection
//   TUT_HERDR_LIST_LAG_POLLS / TUT_HERDR_PANES_LAG — first N `pane list` calls
//                 serve the LAG set instead of TUT_HERDR_PANES (list lag
//                 behind a freshly created tab)
//   TUT_HERDR_AGENT_PANE — virtual readiness target pane id (default FIX:root1)
//   TUT_HERDR_AGENT_STATUS — static virtual agent_status after pane run
//   TUT_HERDR_AGENT_STATUS_SCRIPT — JSON status timeline after pane run
//   TUT_HERDR_REQUIRE_PANE_ID — when 1, pane split --current models Herdr's
//                 headless error if HERDR_PANE_ID is unset or empty
// Split hands out fresh ids FIX:p1, FIX:p2, ... (count = split lines logged);
// tab create hands out FIX:t<n> / root FIX:root<n> the same way.
// Plain JS on purpose: this file is executed directly by node, not vitest.
import { appendFileSync, readFileSync } from "node:fs";

const argv = process.argv.slice(2);
const log = process.env.TUT_HERDR_LOG ?? "";
const logArg = (value) => value.replaceAll("\r", "\\r").replaceAll("\n", "\\n");
if (log.length > 0) appendFileSync(log, `${argv.map(logArg).join(" ")}\n`, "utf8");

const emit = (value) => {
  process.stdout.write(`${JSON.stringify(value)}\n`);
};

const sub = argv[1];

/** How many already-logged invocations start with $1 (this call is logged). */
const loggedCount = (prefix) => {
  try {
    return readFileSync(log, "utf8").split("\n").filter((l) => l.startsWith(prefix)).length;
  } catch {
    return 1; // no log yet — first invocation
  }
};

/** The raw log (empty string when unset/unreadable). */
const readLogFile = () => {
  try {
    return readFileSync(log, "utf8");
  } catch {
    return "";
  }
};

/** The most recent probe send immediately preceding this pane read. */
const latestProbeBeforeRead = (paneId, logText) => {
  const lines = logText.split("\n").filter((line) => line.length > 0);
  const current = lines[lines.length - 1] ?? "";
  if (!current.startsWith(`pane read ${paneId} `)) return undefined;
  const previous = lines[lines.length - 2] ?? "";
  const prefix = `pane send-text ${paneId} printf '`;
  if (!previous.startsWith(prefix)) return undefined;
  const suffix = previous.slice(prefix.length);
  return suffix.match(/^(TUT-DELIVERY-PROBE-[0-9A-F]{8})'\\n$/u)?.[1];
};

/** Whether the current probe's marker should appear in its one read. */
const probeShouldEcho = (paneId, logText, base) => {
  const lines = logText.split("\n").filter((line) => line.length > 0);
  const probeLines = lines.filter((line) => line.startsWith(`pane send-text ${paneId} printf '`));
  const script = process.env.TUT_HERDR_PROBE_SCRIPT;
  if (script !== undefined) {
    const values = JSON.parse(script);
    return values[Math.min(Math.max(probeLines.length - 1, 0), values.length - 1)] === true;
  }
  if (process.env.TUT_HERDR_PROBE_ECHO === "0") return false;
  const enterScript = process.env.TUT_HERDR_READ_ENTER_SCRIPT;
  if (enterScript !== undefined) {
    const enters = lines.filter((line) => line === `pane send-keys ${paneId} Enter`).length;
    const screens = JSON.parse(enterScript);
    const screen = screens[Math.min(Math.max(enters, 0), screens.length - 1)] ?? "";
    return base.length > 0 && !screen.includes("prompt");
  }
  return base.length > 0;
};

// Failure injection: "pane:move" fails every call; "pane:rename:1" only the 1st.
{
  const verb = `${argv[0]}:${sub ?? ""}`; // fail-key form (colon)
  const logVerb = `${argv[0]} ${sub ?? ""}`.trim(); // log-line form (space)
  let failed = false;
  for (const key of (process.env.TUT_HERDR_FAIL ?? "").split(",")) {
    if (!key) continue;
    const parts = key.split(":");
    if (parts.slice(0, 2).join(":") !== verb) continue;
    const nth = parts.length > 2 ? Number(parts[2]) : 0; // 0 = every call
    if (nth === 0 || nth === loggedCount(logVerb)) failed = true;
  }
  if (failed) {
    process.stderr.write(`fixture: simulated ${argv[0]} ${sub} failure\n`);
    process.exit(1);
  }
}

if (argv[0] === "pane" && sub === "list") {
  // list lag: the first N list calls serve the LAG set (a stale view without
  // the fresh tab's panes); the rest serve the current set.
  const lagPolls = Number(process.env.TUT_HERDR_LIST_LAG_POLLS ?? "0") || 0;
  const lagSet = process.env.TUT_HERDR_PANES_LAG;
  const panes =
    lagSet && loggedCount("pane list") <= lagPolls
      ? JSON.parse(lagSet)
      : process.env.TUT_HERDR_PANES
        ? JSON.parse(process.env.TUT_HERDR_PANES)
        : [];
  // Closes are EFFECTIVE (same-role-continuity edition): a pane closed
  // earlier in this run stays closed in later lists. The fixture process
  // is per-invocation, so the log is the shared state — a "pane close <id>"
  // line earlier in the log removes that pane from every later list (the
  // real herdr applies closes immediately; the static list would resurrect
  // corpses past the launcher's addressing-key guard).
  const logText = readLogFile();
  const closed = new Set(
    logText
      .split("\n")
      .filter((l) => l.startsWith("pane close "))
      .map((l) => l.split(" ")[2]),
  );
  const runSeen = logText.split("\n").some((l) => l.startsWith("pane run "));
  let visiblePanes = panes.filter((p) => !closed.has(p.pane_id));
  // Optional lifecycle-status injection for the readiness-bound submit
  // tests. The real Herdr pane list exposes this status on the newborn pane;
  // the fixture adds a virtual target only after pane run so pre-birth anchor
  // discovery remains unchanged. A JSON array advances once per pane-list
  // call after the run, which lets tests model "unknown → idle" without
  // encoding a TUI-specific screen string in launch.sh.
  if (runSeen && (process.env.TUT_HERDR_AGENT_STATUS !== undefined || process.env.TUT_HERDR_AGENT_STATUS_SCRIPT !== undefined)) {
    const target = process.env.TUT_HERDR_AGENT_PANE ?? "FIX:root1";
    const logLines = logText.split("\n");
    let lastRun = -1;
    logLines.forEach((line, index) => {
      if (line.startsWith("pane run ")) lastRun = index;
    });
    const afterRunLists = logLines.slice(lastRun + 1).filter((l) => l === "pane list").length;
    let status = process.env.TUT_HERDR_AGENT_STATUS ?? "unknown";
    if (process.env.TUT_HERDR_AGENT_STATUS_SCRIPT !== undefined) {
      const statuses = JSON.parse(process.env.TUT_HERDR_AGENT_STATUS_SCRIPT);
      status = statuses[Math.min(Math.max(afterRunLists - 1, 0), statuses.length - 1)] ?? "unknown";
    }
    if (!visiblePanes.some((p) => p.pane_id === target)) {
      visiblePanes = [...visiblePanes, { pane_id: target, label: "", agent_status: status }];
    }
  }
  if (process.env.TUT_HERDR_PANES_RAW !== undefined) {
    process.stdout.write(process.env.TUT_HERDR_PANES_RAW);
  } else {
    emit({ id: "cli:pane:list", result: { panes: visiblePanes, type: "pane_list" } });
  }
} else if (argv[0] === "tab" && sub === "list") {
  const tabs = process.env.TUT_HERDR_TABS ? JSON.parse(process.env.TUT_HERDR_TABS) : [];
  emit({ id: "cli:tab:list", result: { tabs, type: "tab_list" } });
} else if (argv[0] === "pane" && sub === "split") {
  if (
    process.env.TUT_HERDR_REQUIRE_PANE_ID === "1" &&
    argv.includes("--current") &&
    (process.env.HERDR_PANE_ID ?? "").trim().length === 0
  ) {
    process.stderr.write("herdr: pane split --current requires HERDR_PANE_ID\n");
    process.exit(1);
  }
  emit({ id: "cli:pane:split", result: { pane: { pane_id: `FIX:p${loggedCount("pane split")}` }, type: "pane_info" } });
} else if (argv[0] === "tab" && sub === "create") {
  const n = loggedCount("tab create");
  const labelIdx = argv.indexOf("--label");
  const label = labelIdx >= 0 ? argv[labelIdx + 1] : "";
  const tabId = `FIX:t${n}`;
  if (process.env.TUT_HERDR_TAB_CREATE_SIGNAL !== undefined) {
    // The command is logged before the signal, so the parent can observe that
    // this attempt happened while the fixture's tab/pane env models the
    // already-created remote objects.
    process.kill(process.pid, process.env.TUT_HERDR_TAB_CREATE_SIGNAL);
  } else if (process.env.TUT_HERDR_TAB_CREATE_RAW !== undefined) {
    // unparseable-but-successful create (raw text, exit 0)
    process.stdout.write(process.env.TUT_HERDR_TAB_CREATE_RAW);
  } else {
    emit({
      id: "cli:tab:create",
      result: {
        root_pane: { pane_id: `FIX:root${n}`, tab_id: tabId },
        tab: { label, tab_id: tabId, pane_count: 1 },
        type: "tab_created",
      },
    });
  }
} else if (argv[0] === "pane" && sub === "move") {
  emit({ id: "cli:pane:move", result: { move_result: { changed: 1, pane: argv[2] }, type: "pane_move" } });
} else if (argv[0] === "pane" && sub === "close") {
  emit({ id: "cli:pane:close", result: { type: "ok" } });
} else if (argv[0] === "pane" && sub === "rename") {
  emit({ id: "cli:pane:rename", result: { pane: { pane_id: argv[2], label: argv[3] }, type: "pane_info" } });
} else if (argv[0] === "pane" && sub === "run") {
  emit({ id: "cli:pane:run", result: { type: "ok" } });
} else if (argv[0] === "pane" && sub === "send-text") {
  emit({ id: "cli:pane:send-text", result: { type: "ok" } });
} else if (argv[0] === "pane" && sub === "send-keys") {
  emit({ id: "cli:pane:send-keys", result: { type: "ok" } });
} else if (argv[0] === "pane" && sub === "get") {
  // `pane get <pane_id>` — the event hook's pane_id → label channel. Label comes
  // from TUT_HERDR_PANE_LABEL (spaces/Unicode welcome) or defaults to a stable
  // derived value; label-failure paths go through the generic TUT_HERDR_FAIL
  // injection above (e.g. TUT_HERDR_FAIL=pane:get), same JSON shape as live
  // herdr: {"result":{"pane":{"pane_id","label"}}}.
  const label = process.env.TUT_HERDR_PANE_LABEL ?? `${argv[2]}:label`;
  if (process.env.TUT_HERDR_PANE_LABEL_RAW !== undefined) {
    process.stdout.write(process.env.TUT_HERDR_PANE_LABEL_RAW);
  } else {
    emit({ id: "cli:pane:get", result: { pane: { pane_id: argv[2], label }, type: "pane_info" } });
  }
} else if (argv[0] === "pane" && sub === "read") {
  // Raw text, no JSON envelope (real herdr pane read prints terminal text).
  // Precedence for the pane being read ($3): ENTER script (post-text reads
  // only, indexed by Enter count — causal for loop-resend tests) → timeline
  // script (read #k → screens[k-1], last repeats) → static knobs.
  const enterScript = process.env.TUT_HERDR_READ_ENTER_SCRIPT;
  const paneId = argv[2];
  const logText = readLogFile();
  let screen;
  if (enterScript !== undefined) {
    const logLines = logText.split("\n");
    const textSentTo = new Set(
      logLines.filter((l) => l.startsWith("pane send-text ")).map((l) => l.split(" ")[2]),
    );
    if (textSentTo.has(paneId)) {
      const enters = logLines.filter((l) => l === `pane send-keys ${paneId} Enter`).length;
      const screens = JSON.parse(enterScript);
      screen = screens[Math.min(enters, screens.length - 1)] ?? "";
    }
  }
  if (screen === undefined && process.env.TUT_HERDR_READ_SCRIPT !== undefined) {
    const script = process.env.TUT_HERDR_READ_SCRIPT;
    const screens = JSON.parse(script);
    const idx = Math.min(loggedCount("pane read") - 1, screens.length - 1);
    screen = screens[idx] ?? "";
  } else if (screen === undefined) {
    const emptyPolls = Number(process.env.TUT_HERDR_READ_EMPTY_POLLS ?? "0") || 0;
    if (loggedCount("pane read") > emptyPolls) {
      screen = process.env.TUT_HERDR_PANE_READ ?? "";
    }
  }
  screen ??= "";
  const marker = latestProbeBeforeRead(paneId, logText);
  if (marker !== undefined && probeShouldEcho(paneId, logText, screen)) {
    process.stdout.write(`${screen}${screen.length > 0 ? "\n" : ""}${marker}`);
  } else {
    process.stdout.write(screen);
  }
} else {
  emit({ id: "cli:pane:fixture", result: { type: "ok" } });
}
